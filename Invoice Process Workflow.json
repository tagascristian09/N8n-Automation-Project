    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  if (Array.isArray(item.json.line_items)) {\n    item.json.line_items = item.json.line_items.map((line) => ({\n      ...line,\n      invoice_number: $('Save Invoice Detail').first().json.id, // Example static field\n      // tax: (parseFloat(line.amount) * 0.12).toFixed(2) // Example calculated field\n    }));\n  }\n}\n\nreturn $input.all();"
      },
