      "parameters": {
        "jsCode": "const departments = [\n  \"Engineering\",\n  \"Marketing\",\n  \"Sales\",\n  \"Human Resources\",\n  \"Finance\",\n  \"Product Management\",\n  \"Customer Support\",\n  \"Legal\",\n  \"Operations\"\n];\n\n// Loop through all incoming items and assign a random department\nfor (const item of $input.all()) {\n  const randomIndex = Math.floor(Math.random() * departments.length);\n  item.json.department = departments[randomIndex];\n}\n\nreturn $input.all();"
      },
